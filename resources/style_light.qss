/* ============================================================
   LogiCheck — Tema Claro Premium (Catppuccin Latte)
   ============================================================ */

/* --- Global --- */
QMainWindow {
    background-color: #eff1f5;
    font-family: 'Segoe UI', 'Inter', Arial, sans-serif;
    color: #4c4f69;
    font-size: 13px;
}

/* Force transparency on all child widgets to prevent white boxes */
QWidget {
    background: transparent;
    font-family: 'Segoe UI', 'Inter', Arial, sans-serif;
    color: #4c4f69;
    font-size: 13px;
}

QLabel {
    background: transparent;
    border: none;
}

QFrame {
    background: transparent;
    border: none;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: #e6e9ef;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #bcc0cc;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #9ca0b0;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* --- Sidebar --- */
#sidebar {
    background-color: #dce0e8;
    border-right: 1px solid #ccd0da;
}

#brandLabel {
    font-size: 22px;
    font-weight: 900;
    color: #1e66f5;
    letter-spacing: 1px;
}

#versionLabel {
    font-size: 11px;
    color: #8c8fa1;
    margin-left: 4px;
}

#sectionLabel {
    font-size: 10px;
    font-weight: 700;
    color: #8c8fa1;
    letter-spacing: 2px;
    margin-left: 4px;
}

#separator {
    background-color: #ccd0da;
}

/* Nav Buttons */
#navButton {
    background: transparent;
    color: #6c6f85;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 500;
}
#navButton:hover {
    background-color: #e6e9ef;
    color: #4c4f69;
}
#navButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(30, 102, 245, 0.15), stop:1 rgba(30, 102, 245, 0.05));
    color: #1e66f5;
    font-weight: 700;
    border-left: 3px solid #1e66f5;
}

/* Theme toggle label */
#themeLabel {
    font-size: 12px;
    color: #6c6f85;
}

/* User card */
#userCard {
    background-color: #e6e9ef;
    border: 1px solid #ccd0da;
    border-radius: 10px;
}
#userName {
    font-size: 13px;
    font-weight: 700;
    color: #4c4f69;
}
#userRole {
    font-size: 11px;
    color: #8c8fa1;
}

/* --- Top Bar --- */
#topBar {
    background-color: #e6e9ef;
    border-bottom: 1px solid #ccd0da;
}
#pageTitle {
    font-size: 18px;
    font-weight: 800;
    color: #4c4f69;
}
#datetimeLabel {
    font-size: 12px;
    color: #6c6f85;
}

/* --- Content Area --- */
#contentArea {
    background-color: #eff1f5;
}

/* --- Glow Cards --- */
#glowCard, #statCard {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 12px;
}
#glowCard:hover, #statCard:hover {
    border-color: #acb0be;
}

/* Welcome Banner */
#welcomeBanner {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #ffffff, stop:0.5 #f5f6fa, stop:1 #e6e9ef);
    border: 1px solid #ccd0da;
    border-radius: 16px;
}
#welcomeTitle {
    font-size: 24px;
    font-weight: 900;
    color: #4c4f69;
}
#welcomeSub {
    font-size: 13px;
    color: #6c6f85;
    line-height: 1.5;
}

/* Stat Cards */
#statDesc {
    font-size: 12px;
    color: #8c8fa1;
}

/* Card titles */
#cardTitle {
    font-size: 15px;
    font-weight: 700;
    color: #4c4f69;
    padding-bottom: 8px;
}

#subtleText {
    font-size: 12px;
    color: #8c8fa1;
}

#modelKey {
    font-size: 13px;
    font-weight: 600;
    color: #6c6f85;
    padding: 4px 0;
}
#modelValue {
    font-size: 13px;
    color: #4c4f69;
    padding: 4px 0;
}

/* --- Buttons --- */
QPushButton#primaryBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1e66f5, stop:1 #209fb5);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#primaryBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #2a75ff, stop:1 #30b0c5);
}
QPushButton#primaryBtn:pressed {
    background: #1e66f5;
}

QPushButton#secondaryBtn {
    background: transparent;
    color: #1e66f5;
    border: 2px solid #1e66f5;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#secondaryBtn:hover {
    background: rgba(30, 102, 245, 0.08);
}

QPushButton#successBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #40a02b, stop:1 #179299);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#successBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4ab835, stop:1 #20a5ac);
}

QPushButton#dangerBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #d20f39, stop:1 #e64553);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#dangerBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #e01a45, stop:1 #f05565);
}

/* --- Tables --- */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f5f6fa;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 8px;
    gridline-color: #e6e9ef;
    font-size: 12px;
    selection-background-color: rgba(30, 102, 245, 0.12);
    selection-color: #4c4f69;
}

QHeaderView::section {
    background-color: #e6e9ef;
    color: #6c6f85;
    padding: 8px 10px;
    border: none;
    border-bottom: 2px solid #ccd0da;
    font-weight: 700;
    font-size: 12px;
}

QTableWidget::item {
    padding: 6px 10px;
    border-bottom: 1px solid #eff1f5;
}

QTableCornerButton::section {
    background-color: #e6e9ef;
    border: none;
}

/* --- Video Frame --- */
#videoFrame {
    background-color: #e6e9ef;
    border: 2px dashed #bcc0cc;
    border-radius: 12px;
    font-size: 15px;
    color: #8c8fa1;
}

/* --- Progress Bar --- */
#videoProgress {
    background-color: #ccd0da;
    border: none;
    border-radius: 3px;
}
#videoProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1e66f5, stop:1 #40a02b);
    border-radius: 3px;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #dce0e8;
    color: #8c8fa1;
    font-size: 11px;
    border-top: 1px solid #ccd0da;
    padding: 2px 10px;
}
