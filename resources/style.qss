/* ============================================================
   LogiCheck — Tema Oscuro Premium (Catppuccin Mocha)
   ============================================================ */

/* --- Global --- */
QMainWindow {
    background-color: #1e1e2e;
    font-family: 'Segoe UI', 'Inter', Arial, sans-serif;
    color: #cdd6f4;
    font-size: 13px;
}

/* Base Widget */
QWidget {
    font-family: 'Segoe UI', 'Inter', Arial, sans-serif;
    color: #cdd6f4;
    font-size: 13px;
    background: transparent; /* Volvemos a transparent por defecto para el layout */
}

/* Regla específica para que no todo herede la transparencia del QWidget */
#contentArea, QMainWindow, QDialog {
    background-color: #1e1e2e;
}

QLabel {
    background: transparent;
    border: none;
}

QFrame {
    background: transparent;
    border: none;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: #181825;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #45475a;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #585b70;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* --- Sidebar --- */
#sidebar {
    background-color: #11111b;
    border-right: 1px solid #1e1e2e;
}

#brandLabel {
    font-size: 22px;
    font-weight: 900;
    color: #89b4fa;
    letter-spacing: 1px;
}

#versionLabel {
    font-size: 11px;
    color: #6c7086;
    margin-left: 4px;
}

#sectionLabel {
    font-size: 10px;
    font-weight: 700;
    color: #6c7086;
    letter-spacing: 2px;
    margin-left: 4px;
}

#separator {
    background-color: #313244;
}

/* Nav Buttons */
#navButton {
    background: transparent;
    color: #a6adc8;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 500;
}
#navButton:hover {
    background-color: #1e1e2e;
    color: #cdd6f4;
}
#navButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(137, 180, 250, 0.18), stop:1 rgba(137, 180, 250, 0.06));
    color: #89b4fa;
    font-weight: 700;
    border-left: 3px solid #89b4fa;
}

/* Theme toggle label */
#themeLabel {
    font-size: 12px;
    color: #a6adc8;
}

/* User card */
#userCard {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 10px;
}
#userName {
    font-size: 13px;
    font-weight: 700;
    color: #cdd6f4;
}
#userRole {
    font-size: 11px;
    color: #6c7086;
}

/* --- Top Bar --- */
#topBar {
    background-color: #181825;
    border-bottom: 1px solid #1e1e2e;
}
#pageTitle {
    font-size: 18px;
    font-weight: 800;
    color: #cdd6f4;
}
#datetimeLabel {
    font-size: 12px;
    color: #a6adc8;
}

/* --- Content Area --- */
#contentArea {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                stop:0 #1e1e2e, stop:1 #11111b);
}

/* --- Glow Cards --- */
#glowCard, #statCard {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 12px;
}
#glowCard:hover, #statCard:hover {
    border-color: #45475a;
}

/* Welcome Banner */
#welcomeBanner {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1e1e2e, stop:0.5 #1a1a2e, stop:1 #181825);
    border: 1px solid #313244;
    border-radius: 16px;
}
#welcomeTitle {
    font-size: 24px;
    font-weight: 900;
    color: #cdd6f4;
}
#welcomeSub {
    font-size: 13px;
    color: #a6adc8;
    line-height: 1.5;
}

/* Stat Cards */
#statDesc {
    font-size: 12px;
    color: #6c7086;
}

/* Card titles */
#cardTitle {
    font-size: 15px;
    font-weight: 700;
    color: #cdd6f4;
    padding-bottom: 8px;
}

#subtleText {
    font-size: 12px;
    color: #6c7086;
}

#modelKey {
    font-size: 13px;
    font-weight: 600;
    color: #a6adc8;
    padding: 4px 0;
}
#modelValue {
    font-size: 13px;
    color: #cdd6f4;
    padding: 4px 0;
}

/* --- Usuarios StatCards (Dark Mode overrides) --- */
#statValue[card_id="total"]       { color: #89b4fa !important; }
#statValue[card_id="active"]      { color: #a6e3a1 !important; }
#statValue[card_id="inactive"]    { color: #f38ba8 !important; }
#statValue[card_id="roles"]       { color: #cba6f7 !important; }

#statIcon[card_id="total"]        { color: #89b4fa !important; }
#statIcon[card_id="active"]       { color: #a6e3a1 !important; }
#statIcon[card_id="inactive"]     { color: #f38ba8 !important; }
#statIcon[card_id="roles"]        { color: #cba6f7 !important; }

/* --- Table Action Buttons --- */
QPushButton#btnTableEdit { background: rgba(137, 180, 250, 0.15); color: #89b4fa; border: 1px solid rgba(137, 180, 250, 0.35); border-radius: 6px; font-size: 11px; font-weight: 700; padding: 0 10px; }
QPushButton#btnTableEdit:hover { background: rgba(137, 180, 250, 0.28); }

QPushButton#btnTablePass { background: rgba(203, 166, 247, 0.15); color: #cba6f7; border: 1px solid rgba(203, 166, 247, 0.35); border-radius: 6px; font-size: 11px; font-weight: 700; padding: 0 10px; }
QPushButton#btnTablePass:hover { background: rgba(203, 166, 247, 0.28); }

QPushButton#btnTableToggleOff { background: rgba(243, 139, 168, 0.15); color: #f38ba8; border: 1px solid rgba(243, 139, 168, 0.35); border-radius: 6px; font-size: 11px; font-weight: 700; padding: 0 10px; }
QPushButton#btnTableToggleOff:hover { background: rgba(243, 139, 168, 0.28); }

QPushButton#btnTableToggleOn { background: rgba(166, 227, 161, 0.15); color: #a6e3a1; border: 1px solid rgba(166, 227, 161, 0.35); border-radius: 6px; font-size: 11px; font-weight: 700; padding: 0 10px; }
QPushButton#btnTableToggleOn:hover { background: rgba(166, 227, 161, 0.28); }

QPushButton#btnTableClone { background: rgba(166, 227, 161, 0.15); color: #a6e3a1; border: 1px solid rgba(166, 227, 161, 0.35); border-radius: 6px; font-size: 11px; font-weight: 700; padding: 0 10px; }
QPushButton#btnTableClone:hover { background: rgba(166, 227, 161, 0.28); }

/* --- Buttons --- */
QPushButton#primaryBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #89b4fa, stop:1 #74c7ec);
    color: #11111b;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#primaryBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #b4befe, stop:1 #89dceb);
}
QPushButton#primaryBtn:pressed {
    background: #74c7ec;
}

QPushButton#secondaryBtn {
    background: transparent;
    color: #89b4fa;
    border: 2px solid #89b4fa;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#secondaryBtn:hover {
    background: rgba(137, 180, 250, 0.12);
}

QPushButton#successBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #a6e3a1, stop:1 #94e2d5);
    color: #11111b;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#successBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #b4eeaf, stop:1 #a6f0e0);
}

QPushButton#dangerBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #f38ba8, stop:1 #eba0ac);
    color: #11111b;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#dangerBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #f5a0b8, stop:1 #f0b8c0);
}

QPushButton#warningBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #fab387, stop:1 #f9e2af);
    color: #11111b;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#warningBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #f9c88a, stop:1 #fcd5a8);
}
QPushButton#warningBtn:disabled { background: #45475a; color: #6c7086; }

/* --- Tables --- */
QTableWidget {
    background-color: #1e1e2e;
    alternate-background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 8px;
    gridline-color: #313244;
    font-size: 12px;
    selection-background-color: rgba(137, 180, 250, 0.2);
    selection-color: #cdd6f4;
}

QHeaderView::section {
    background-color: #11111b;
    color: #a6adc8;
    padding: 8px 10px;
    border: none;
    border-bottom: 2px solid #313244;
    font-weight: 700;
    font-size: 12px;
}

QTableWidget::item {
    padding: 6px 10px;
    border-bottom: 1px solid #1e1e2e;
}

QTableCornerButton::section {
    background-color: #11111b;
    border: none;
}

/* --- Video Frame --- */
#videoFrame {
    background-color: #11111b;
    border: 2px dashed #313244;
    border-radius: 12px;
    font-size: 15px;
    color: #585b70;
}

/* Video status pill */
#videoStatusPill {
    padding: 6px 12px;
    border-radius: 999px;
    font-weight: 900;
    font-size: 12px;
    border: 1px solid rgba(69, 71, 90, 0.75);
    background-color: rgba(49, 50, 68, 0.55);
    color: #a6adc8;
}
#videoStatusPill[state="idle"] { color: #6c7086; }
#videoStatusPill[state="queued"] { border-color: rgba(249, 226, 175, 0.55); color: #f9e2af; }
#videoStatusPill[state="analyzing"] { border-color: rgba(203, 166, 247, 0.55); color: #cba6f7; }
#videoStatusPill[state="ready"] { border-color: rgba(166, 227, 161, 0.55); color: #a6e3a1; }

/* --- Player buttons --- */
#playerBtn {
    background-color: rgba(205, 214, 244, 0.08);
    border: 1px solid rgba(69, 71, 90, 0.75);
    border-radius: 18px;
    color: #cdd6f4;
    font-size: 16px;
    font-weight: 900;
}
#playerBtn:hover { background-color: rgba(205, 214, 244, 0.12); }
#playerBtn:pressed { background-color: rgba(205, 214, 244, 0.16); }
#playerBtn[ready="true"] {
    border: 1px solid rgba(137, 180, 250, 0.75);
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(137, 180, 250, 0.35), stop:1 rgba(166, 227, 161, 0.22));
}

/* --- Progress Bar --- */
#videoProgress {
    background-color: #313244;
    border: none;
    border-radius: 3px;
}
#videoProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #89b4fa, stop:1 #a6e3a1);
    border-radius: 3px;
}

/* --- Analysis Progress Bar (premium) --- */
#analysisProgress {
    background-color: rgba(49, 50, 68, 0.65);
    border: 1px solid rgba(69, 71, 90, 0.75);
    border-radius: 4px;
}
#analysisProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #89b4fa, stop:0.5 #cba6f7, stop:1 #a6e3a1);
    border-radius: 4px;
}

/* Speed selector in player bar */
#speedBtn {
    background-color: rgba(137, 180, 250, 0.12);
    color: #cdd6f4;
    border: 1px solid rgba(137, 180, 250, 0.28);
    border-radius: 8px;
    padding: 7px 10px;
    font-weight: 800;
}
#speedBtn:hover {
    background-color: rgba(137, 180, 250, 0.18);
    border-color: rgba(137, 180, 250, 0.4);
}

/* Speed panel (YouTube-like) */
#speedPanelCard {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 14px;
}
#speedPanelTitle {
    font-size: 13px;
    font-weight: 900;
    color: #a6adc8;
}
#speedPanelValue {
    font-size: 28px;
    font-weight: 900;
    color: #cdd6f4;
    padding: 2px 0 6px 0;
}
#speedAdjustBtn {
    background-color: rgba(205, 214, 244, 0.08);
    border: 1px solid rgba(69, 71, 90, 0.75);
    border-radius: 18px;
    color: #cdd6f4;
    font-size: 16px;
    font-weight: 900;
}
#speedAdjustBtn:hover { background-color: rgba(205, 214, 244, 0.12); }
#speedAdjustBtn:pressed { background-color: rgba(205, 214, 244, 0.16); }
#speedAdjustBtn:focus { outline: none; }

#speedPanelSlider::groove:horizontal {
    height: 7px;
    border-radius: 3px;
    background: rgba(49, 50, 68, 0.95);
}
#speedPanelSlider::sub-page:horizontal {
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #89b4fa, stop:1 #a6e3a1);
}
#speedPanelSlider::handle:horizontal {
    width: 14px;
    margin: -6px 0;
    border-radius: 7px;
    background: #cdd6f4;
}

#speedChip {
    background-color: rgba(205, 214, 244, 0.08);
    border: 1px solid rgba(69, 71, 90, 0.75);
    color: #cdd6f4;
    border-radius: 999px;
    padding: 7px 12px;
    min-height: 32px;
    min-width: 44px; /* keeps small values from looking boxy */
    font-weight: 900;
}
#speedChip:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(137, 180, 250, 0.28), stop:1 rgba(166, 227, 161, 0.18));
    border: 1px solid rgba(137, 180, 250, 0.55);
    color: #cdd6f4;
}
#speedChip:hover { background-color: rgba(205, 214, 244, 0.12); }
#speedChip:pressed { background-color: rgba(205, 214, 244, 0.16); }
#speedChip:focus { outline: none; border: 1px solid rgba(137, 180, 250, 0.45); }

/* Scrub tooltip */
#scrubTooltip {
    background-color: rgba(17, 17, 27, 0.92);
    border: 1px solid rgba(69, 71, 90, 0.80);
    border-radius: 10px;
    padding: 6px 10px;
    color: #cdd6f4;
    font-weight: 900;
    font-size: 12px;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #11111b;
    color: #6c7086;
    font-size: 11px;
    border-top: 1px solid #1e1e2e;
    padding: 2px 10px;
}

/* --- Logout Button --- */
#logoutBtn {
    background: transparent;
    color: #f38ba8;
    border: 1px solid rgba(243, 139, 168, 0.35);
    border-radius: 8px;
    text-align: left;
    padding: 0 14px;
    font-size: 12px;
    font-weight: 600;
}
#logoutBtn:hover {
    background: rgba(243, 139, 168, 0.12);
    border-color: #f38ba8;
    color: #f38ba8;
}
#logoutBtn:pressed {
    background: rgba(243, 139, 168, 0.22);
}
/* --- Inputs & Combos --- */
QLineEdit, QComboBox, QDateTimeEdit {
    background-color: #11111b;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 6px 12px;
    color: #cdd6f4;
    selection-background-color: #313244;
}

QLineEdit:focus, QComboBox:focus, QDateTimeEdit:focus {
    border-color: #89b4fa;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #a6adc8;
    margin-right: 10px;
}

/* Fix for transparent dropdown backgrounds */
QComboBox QAbstractItemView {
    background-color: #11111b !important;
    border: 1px solid #313244;
    border-radius: 8px;
    color: #cdd6f4;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding-left: 8px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #313244;
    color: #89b4fa;
    border-radius: 4px;
}

/* Tooltips y Menús */
QToolTip {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #45475a;
    padding: 4px;
}

/* Dialogs */
QDialog {
    background-color: #1e1e2e;
}

/* --- Panel de Permisos (Gestión de Usuarios) --- */
#permScroll { 
    border: 1px solid #313244; 
    border-radius: 10px; 
    background-color: #11111b; 
}
#permContainer { background: transparent; }
#permLabel { color: #cdd6f4; font-size: 13px; }
#inheritedLabel { color: #6c7086; font-size: 11px; }
#inheritedLabel[has_base="true"] { color: #a6e3a1; }
#inheritedLabel[has_base="false"] { color: #f38ba8; }

/* --- Toasts --- */
#toastNotification {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 12px;
}
#toastNotification[type="success"] { border-left: 6px solid #a6e3a1; }
#toastNotification[type="error"]   { border-left: 6px solid #f38ba8; }
#toastNotification[type="warning"] { border-left: 6px solid #f9e2af; }
#toastNotification[type="info"]    { border-left: 6px solid #89b4fa; }

#toastMsg {
    color: #cdd6f4;
    font-size: 13px;
    font-weight: 600;
}

#detectionsList {
    background-color: #11111b;
    border: none;
    border-radius: 8px;
    color: #a6e3a1;
    font-family: 'Consolas', monospace;
    font-size: 12px;
}

/* --- Audit Result Badge --- */
#auditResultBadge {
    font-size: 13px;
    font-weight: 900;
    color: #6c7086;
    background: transparent;
    border-radius: 6px;
    padding: 2px 8px;
}
#auditResultBadge[result="CONFORME"]     { color: #a6e3a1; background: rgba(166,227,161,0.10); }
#auditResultBadge[result="DISCREPANCIA"]{ color: #f38ba8; background: rgba(243,139,168,0.10); }

/* --- Comparison Table (small, compact) --- */
QTableWidget#comparisonTable {
    background-color: #11111b;
    border: 1px solid #313244;
    border-radius: 8px;
    font-size: 11px;
}

/* --- Cámara en Vivo: status pill extra states --- */
#videoStatusPill[state="ok"]           { border-color: rgba(166, 227, 161, 0.55); color: #a6e3a1; }
#videoStatusPill[state="connecting"]   { border-color: rgba(249, 226, 175, 0.55); color: #f9e2af; }
#videoStatusPill[state="reconnecting"] { border-color: rgba(250, 179, 135, 0.55); color: #fab387; }

/* Camera URL input: override placeholder tint */
#camUrlInput {
    background-color: #11111b;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 6px 14px;
    color: #cdd6f4;
    font-size: 12px;
}
#camUrlInput:focus {
    border-color: #a6e3a1;
}
#camUrlInput::placeholder {
    color: #45475a;
}

/* Small player buttons (accent) */
#playerBtn_accent {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(203, 166, 247, 0.22), stop:1 rgba(137, 180, 250, 0.18));
    border: 1px solid rgba(203, 166, 247, 0.45);
    border-radius: 8px;
    color: #cba6f7;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 12px;
}
#playerBtn_accent:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(203, 166, 247, 0.32), stop:1 rgba(137, 180, 250, 0.26));
}
#playerBtn_small {
    background-color: rgba(205, 214, 244, 0.08);
    border: 1px solid rgba(69, 71, 90, 0.75);
    border-radius: 8px;
    color: #a6adc8;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 10px;
}
#playerBtn_small:hover { background-color: rgba(205, 214, 244, 0.13); }
#playerBtn_small:disabled { color: #45475a; border-color: #313244; }

/* --- Dahua History Dialog --- */
#videoPreviewFrame {
    background-color: #11111b;
    border: 2px solid #313244;
    border-radius: 10px;
    color: #585b70;
    font-size: 14px;
}

#actionsCard {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 10px;
}

/* --- Shared Dialog Components global styles --- */
QGroupBox {
    background-color: #1a1a26;
    border: 1px solid #313244;
    border-radius: 10px;
    margin-top: 14px;
    padding: 10px;
    color: #89b4fa;
    font-weight: 700;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QCalendarWidget {
    background-color: #11111b;
    border: 1px solid #313244;
    border-radius: 8px;
}
QCalendarWidget QAbstractItemView:enabled {
    background-color: #11111b;
    selection-background-color: #89b4fa;
    selection-color: #11111b;
    color: #cdd6f4;
}
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #181825;
}
QCalendarWidget QToolButton {
    color: #89b4fa;
    font-weight: 700;
    background: transparent;
    border-radius: 4px;
    padding: 4px;
}
QCalendarWidget QToolButton:hover { background: #313244; }
QCalendarWidget QSpinBox {
    background: #181825;
    border: 1px solid #313244;
    color: #cdd6f4;
}
QCalendarWidget QHeaderView { 
    outline: none;
    border: none;
}

#speedLabel {
    font-size: 24px;
    font-weight: 900;
    color: #89b4fa;
    background: #181825;
    border-radius: 8px;
    padding: 10px;
    border: 1px solid #313244;
}
