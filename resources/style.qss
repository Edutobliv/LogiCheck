/* ============================================================
   LogiCheck — Tema Oscuro Premium v2.0 (Premium Dark Glassmorphism (Slate/Neon))
   ============================================================ */

/* ─── Importar fuente Inter desde Google Fonts (carga si hay conexión) ─── */
/* @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap'); */

/* --- Global --- */
QMainWindow {
    background-color: #0F172A;
    font-family: 'Segoe UI', 'Inter', Arial, sans-serif;
    color: #F8FAFC;
    font-size: 13px;
}

QWidget {
    font-family: 'Segoe UI', 'Inter', Arial, sans-serif;
    color: #F8FAFC;
    font-size: 13px;
    background: transparent;
}

#contentArea, QMainWindow, QDialog {
    background-color: #0F172A;
}

QLabel {
    background: transparent;
    border: none;
}

QFrame {
    background: transparent;
    border: none;
}

QScrollArea {
    background: transparent;
    border: none;
}

/* ─── Scrollbars ─── */
QScrollBar:vertical {
    background: #0B0F19;
    width: 7px;
    border-radius: 3px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #334155;
    border-radius: 3px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover {
    background: #64748B;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: #0B0F19;
    height: 7px;
    border-radius: 3px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #334155;
    border-radius: 3px;
    min-width: 28px;
}
QScrollBar::handle:horizontal:hover {
    background: #64748B;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ─── Sidebar ─── */
#sidebar {
    background-color: #020617;
    border-right: 1px solid #0B0F19;
}

#brandLabel {
    font-size: 22px;
    font-weight: 900;
    color: #3B82F6;
    letter-spacing: 1px;
}

#versionLabel {
    font-size: 11px;
    color: #64748B;
    margin-left: 4px;
}

#sectionLabel {
    font-size: 10px;
    font-weight: 700;
    color: #334155;
    letter-spacing: 2.5px;
    margin-left: 4px;
}

#separator {
    background-color: #0F172A;
    max-height: 1px;
}

/* ─── Nav Buttons ─── */
#navButton {
    background: transparent;
    color: #94A3B8;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 500;
}
#navButton:hover {
    background-color: #0F172A;
    color: #F8FAFC;
}
#navButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(59, 130, 246, 0.22), stop:1 rgba(59, 130, 246, 0.05));
    color: #3B82F6;
    font-weight: 700;
    border-left: 3px solid #3B82F6;
}
#navButton:pressed {
    background-color: rgba(59, 130, 246, 0.15);
}

/* ─── Theme label ─── */
#themeLabel {
    font-size: 12px;
    color: #94A3B8;
}

/* ─── User card ─── */
#userCard {
    background-color: #0B0F19;
    border: 1px solid #1E293B;
    border-radius: 10px;
}
#userName {
    font-size: 13px;
    font-weight: 700;
    color: #F8FAFC;
}
#userRole {
    font-size: 11px;
    color: #64748B;
}

/* ─── Top Bar ─── */
#topBar {
    background-color: #0B0F19;
    border-bottom: 1px solid #0F172A;
}
#pageTitle {
    font-size: 18px;
    font-weight: 800;
    color: #F8FAFC;
    letter-spacing: -0.3px;
}
#datetimeLabel {
    font-size: 12px;
    color: #64748B;
}

/* ─── Content Area ─── */
#contentArea {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                stop:0 #0F172A, stop:1 #020617);
}

/* ─── Glow Cards ─── */
#glowCard, #statCard {
    background-color: #0B0F19;
    border: 1px solid #1E293B;
    border-radius: 14px;
}
#glowCard:hover, #statCard:hover {
    border-color: #334155;
}

/* ─── Welcome Banner ─── */
#welcomeBanner {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0F172A, stop:0.4 #1c1c30, stop:0.8 #1a1a2e, stop:1 #0B0F19);
    border: 1px solid #1E293B;
    border-radius: 16px;
}
#welcomeTitle {
    font-size: 26px;
    font-weight: 900;
    color: #F8FAFC;
    letter-spacing: -0.5px;
}
#welcomeSub {
    font-size: 13px;
    color: #CBD5E1;
    line-height: 1.6;
}

/* ─── Accent bar ─── */
#accentBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3B82F6, stop:0.3 #8B5CF6, stop:0.7 #EF4444, stop:1 #F59E0B);
    border-radius: 2px;
    margin: 0 20px;
}

/* ─── Stat cards ─── */
#statDesc {
    font-size: 11px;
    color: #64748B;
    font-weight: 600;
    letter-spacing: 0.3px;
}

/* ─── Card titles ─── */
#cardTitle {
    font-size: 15px;
    font-weight: 800;
    color: #F8FAFC;
    padding-bottom: 10px;
    letter-spacing: -0.2px;
}

#subtleText {
    font-size: 12px;
    color: #64748B;
}

#modelKey {
    font-size: 13px;
    font-weight: 600;
    color: #CBD5E1;
    padding: 4px 0;
}
#modelValue {
    font-size: 13px;
    color: #F8FAFC;
    padding: 4px 0;
}

/* ─── StatCard IDs (hover glow) ─── */
#statValue[card_id="total"]       { color: #3B82F6 !important; }
#statValue[card_id="active"]      { color: #10B981 !important; }
#statValue[card_id="inactive"]    { color: #EF4444 !important; }
#statValue[card_id="roles"]       { color: #8B5CF6 !important; }

#statIcon[card_id="total"]        { color: #3B82F6 !important; }
#statIcon[card_id="active"]       { color: #10B981 !important; }
#statIcon[card_id="inactive"]     { color: #EF4444 !important; }
#statIcon[card_id="roles"]        { color: #8B5CF6 !important; }

/* ─── Table Action Buttons ─── */
QPushButton#btnTableEdit {
    background: rgba(59, 130, 246, 0.12);
    color: #3B82F6;
    border: 1px solid rgba(59, 130, 246, 0.30);
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    padding: 0 10px;
}
QPushButton#btnTableEdit:hover { background: rgba(59, 130, 246, 0.22); border-color: #3B82F6; }

QPushButton#btnTablePass {
    background: rgba(139, 92, 246, 0.12);
    color: #8B5CF6;
    border: 1px solid rgba(139, 92, 246, 0.30);
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    padding: 0 10px;
}
QPushButton#btnTablePass:hover { background: rgba(139, 92, 246, 0.22); border-color: #8B5CF6; }

QPushButton#btnTableToggleOff {
    background: rgba(239, 68, 68, 0.12);
    color: #EF4444;
    border: 1px solid rgba(239, 68, 68, 0.30);
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    padding: 0 10px;
}
QPushButton#btnTableToggleOff:hover { background: rgba(239, 68, 68, 0.22); border-color: #EF4444; }

QPushButton#btnTableToggleOn {
    background: rgba(16, 185, 129, 0.12);
    color: #10B981;
    border: 1px solid rgba(16, 185, 129, 0.30);
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    padding: 0 10px;
}
QPushButton#btnTableToggleOn:hover { background: rgba(16, 185, 129, 0.22); border-color: #10B981; }

QPushButton#btnTableClone {
    background: rgba(16, 185, 129, 0.12);
    color: #10B981;
    border: 1px solid rgba(16, 185, 129, 0.30);
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    padding: 0 10px;
}
QPushButton#btnTableClone:hover { background: rgba(16, 185, 129, 0.22); border-color: #10B981; }

/* ─── Buttons ─── */
QPushButton#primaryBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3B82F6, stop:1 #0EA5E9);
    color: #020617;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#primaryBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #818CF8, stop:1 #89dceb);
}
QPushButton#primaryBtn:pressed { background: #0EA5E9; }
QPushButton#primaryBtn:disabled { background: #1E293B; color: #334155; }

QPushButton#secondaryBtn {
    background: transparent;
    color: #3B82F6;
    border: 2px solid #334155;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#secondaryBtn:hover {
    background: rgba(59, 130, 246, 0.12);
    border-color: #3B82F6;
    color: #818CF8;
}
QPushButton#secondaryBtn:pressed { background: rgba(59, 130, 246, 0.20); }

QPushButton#successBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #10B981, stop:1 #14B8A6);
    color: #020617;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#successBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #b8f0b3, stop:1 #a8eee4);
}
QPushButton#successBtn:pressed { background: #14B8A6; }
QPushButton#successBtn:disabled { background: #1E293B; color: #334155; }

QPushButton#dangerBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #EF4444, stop:1 #eba0ac);
    color: #020617;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#dangerBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #f5a0b8, stop:1 #f0b8c0);
}
QPushButton#dangerBtn:pressed { background: #eba0ac; }
QPushButton#dangerBtn:disabled { background: #1E293B; color: #334155; }

QPushButton#warningBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #F59E0B, stop:1 #f9e2af);
    color: #020617;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#warningBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #f9c88a, stop:1 #fcd5a8);
}
QPushButton#warningBtn:disabled { background: #1E293B; color: #334155; }

/* ─── Tables ─── */
QTableWidget {
    background-color: #0F172A;
    alternate-background-color: #0B0F19;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 8px;
    gridline-color: #0F172A;
    font-size: 12px;
    selection-background-color: rgba(59, 130, 246, 0.18);
    selection-color: #F8FAFC;
    outline: none;
}

QHeaderView::section {
    background-color: #020617;
    color: #94A3B8;
    padding: 8px 10px;
    border: none;
    border-bottom: 2px solid #1E293B;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
}

QTableWidget::item {
    padding: 7px 10px;
    border-bottom: 1px solid #0F172A;
}
QTableWidget::item:selected {
    background: rgba(59, 130, 246, 0.18);
    color: #F8FAFC;
    border-radius: 4px;
}
QTableWidget::item:hover {
    background: rgba(255, 255, 255, 0.04);
}

QTableCornerButton::section {
    background-color: #020617;
    border: none;
}

/* ─── Video Frame ─── */
#videoFrame {
    background-color: #020617;
    border: 2px dashed #1E293B;
    border-radius: 12px;
    font-size: 15px;
    color: #334155;
}

/* ─── Video status pill ─── */
#videoStatusPill {
    padding: 5px 12px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 11px;
    border: 1px solid #1E293B;
    background-color: rgba(49, 50, 68, 0.60);
    color: #64748B;
}
#videoStatusPill[state="idle"]        { color: #64748B; border-color: #1E293B; }
#videoStatusPill[state="queued"]      { border-color: rgba(245, 158, 11, 0.55); color: #f9e2af; background: rgba(249,226,175,0.08); }
#videoStatusPill[state="analyzing"]   { border-color: rgba(139, 92, 246, 0.55); color: #8B5CF6; background: rgba(203,166,247,0.08); }
#videoStatusPill[state="ready"]       { border-color: rgba(16, 185, 129, 0.55); color: #10B981; background: rgba(166,227,161,0.08); }
#videoStatusPill[state="ok"]          { border-color: rgba(16, 185, 129, 0.55); color: #10B981; background: rgba(166,227,161,0.08); }
#videoStatusPill[state="connecting"]  { border-color: rgba(245, 158, 11, 0.55); color: #f9e2af; background: rgba(249,226,175,0.08); }
#videoStatusPill[state="reconnecting"]{ border-color: rgba(250, 179, 135, 0.55); color: #F59E0B; background: rgba(250,179,135,0.08); }

/* ─── Player buttons ─── */
#playerBtn {
    background-color: rgba(205, 214, 244, 0.07);
    border: 1px solid rgba(69, 71, 90, 0.70);
    border-radius: 18px;
    color: #F8FAFC;
    font-size: 16px;
    font-weight: 900;
}
#playerBtn:hover  { background-color: rgba(205, 214, 244, 0.13); border-color: rgba(137,180,250,0.45); }
#playerBtn:pressed { background-color: rgba(205, 214, 244, 0.18); }
#playerBtn:disabled { color: #334155; border-color: #1E293B; }
#playerBtn[ready="true"] {
    border: 1px solid rgba(59, 130, 246, 0.70);
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(59, 130, 246, 0.30), stop:1 rgba(16, 185, 129, 0.18));
}

/* ─── Progress Bar ─── */
#videoProgress {
    background-color: #1E293B;
    border: none;
    border-radius: 3px;
}
#videoProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3B82F6, stop:1 #10B981);
    border-radius: 3px;
}

/* ─── Analysis Progress Bar (premium) ─── */
#analysisProgress {
    background-color: rgba(49, 50, 68, 0.65);
    border: 1px solid rgba(69, 71, 90, 0.75);
    border-radius: 4px;
}
#analysisProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3B82F6, stop:0.5 #8B5CF6, stop:1 #10B981);
    border-radius: 4px;
}

/* ─── Speed selector ─── */
#speedBtn {
    background-color: rgba(59, 130, 246, 0.10);
    color: #F8FAFC;
    border: 1px solid rgba(59, 130, 246, 0.24);
    border-radius: 8px;
    padding: 7px 10px;
    font-weight: 800;
}
#speedBtn:hover {
    background-color: rgba(59, 130, 246, 0.17);
    border-color: rgba(59, 130, 246, 0.40);
}

/* ─── Speed panel ─── */
#speedPanelCard {
    background-color: #0B0F19;
    border: 1px solid #1E293B;
    border-radius: 14px;
}
#speedPanelTitle {
    font-size: 13px;
    font-weight: 800;
    color: #CBD5E1;
}
#speedPanelValue {
    font-size: 28px;
    font-weight: 900;
    color: #F8FAFC;
    padding: 2px 0 6px 0;
}
#speedAdjustBtn {
    background-color: rgba(205, 214, 244, 0.07);
    border: 1px solid rgba(69, 71, 90, 0.70);
    border-radius: 18px;
    color: #F8FAFC;
    font-size: 16px;
    font-weight: 900;
}
#speedAdjustBtn:hover  { background-color: rgba(205, 214, 244, 0.13); border-color: rgba(137,180,250,0.40); }
#speedAdjustBtn:pressed { background-color: rgba(205, 214, 244, 0.18); }
#speedAdjustBtn:focus  { outline: none; }

#speedPanelSlider::groove:horizontal {
    height: 7px;
    border-radius: 3px;
    background: rgba(49, 50, 68, 0.95);
}
#speedPanelSlider::sub-page:horizontal {
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3B82F6, stop:1 #10B981);
}
#speedPanelSlider::handle:horizontal {
    width: 14px;
    margin: -6px 0;
    border-radius: 7px;
    background: #F8FAFC;
}

#speedChip {
    background-color: rgba(205, 214, 244, 0.07);
    border: 1px solid rgba(69, 71, 90, 0.70);
    color: #F8FAFC;
    border-radius: 999px;
    padding: 7px 12px;
    min-height: 32px;
    min-width: 44px;
    font-weight: 800;
}
#speedChip:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(59, 130, 246, 0.28), stop:1 rgba(16, 185, 129, 0.16));
    border: 1px solid rgba(59, 130, 246, 0.55);
    color: #818CF8;
}
#speedChip:hover  { background-color: rgba(205, 214, 244, 0.12); }
#speedChip:pressed { background-color: rgba(205, 214, 244, 0.18); }
#speedChip:focus  { outline: none; border: 1px solid rgba(59, 130, 246, 0.45); }

/* ─── Scrub tooltip ─── */
#scrubTooltip {
    background-color: rgba(17, 17, 27, 0.94);
    border: 1px solid rgba(69, 71, 90, 0.80);
    border-radius: 10px;
    padding: 6px 10px;
    color: #F8FAFC;
    font-weight: 800;
    font-size: 12px;
}

/* ─── Status Bar ─── */
QStatusBar {
    background-color: #020617;
    color: #64748B;
    font-size: 11px;
    border-top: 1px solid #0F172A;
    padding: 2px 10px;
}
QStatusBar::item { border: none; }

/* ─── Logout button ─── */
#logoutBtn {
    background: transparent;
    color: #EF4444;
    border: 1px solid rgba(239, 68, 68, 0.30);
    border-radius: 8px;
    text-align: left;
    padding: 0 14px;
    font-size: 12px;
    font-weight: 600;
}
#logoutBtn:hover {
    background: rgba(239, 68, 68, 0.10);
    border-color: #EF4444;
}
#logoutBtn:pressed { background: rgba(239, 68, 68, 0.20); }

/* ─── Inputs & Combos ─── */
QLineEdit, QComboBox, QDateTimeEdit {
    background-color: #0B0F19;
    border: 1.5px solid #1E293B;
    border-radius: 8px;
    padding: 6px 12px;
    color: #F8FAFC;
    selection-background-color: rgba(59, 130, 246, 0.25);
}
QLineEdit:focus, QComboBox:focus, QDateTimeEdit:focus {
    border-color: #3B82F6;
    background-color: #0F172A;
}
QLineEdit::placeholder, QLineEdit[text=""]::placeholder { color: #334155; }

QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #64748B;
    margin-right: 10px;
}
QComboBox QAbstractItemView {
    background-color: #0B0F19 !important;
    border: 1px solid #1E293B;
    border-radius: 8px;
    color: #F8FAFC;
    outline: none;
    padding: 4px;
}
QComboBox QAbstractItemView::item { min-height: 28px; padding-left: 8px; }
QComboBox QAbstractItemView::item:selected {
    background-color: rgba(59, 130, 246, 0.20);
    color: #3B82F6;
    border-radius: 4px;
}

/* ─── CheckBox ─── */
QCheckBox {
    color: #CBD5E1;
    spacing: 8px;
    font-size: 13px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid #334155;
    border-radius: 4px;
    background: #020617;
}
QCheckBox::indicator:hover { border-color: #3B82F6; }
QCheckBox::indicator:checked {
    background: #3B82F6;
    border-color: #3B82F6;
}

/* ─── ToolTips & Menus ─── */
QToolTip {
    background-color: #0B0F19;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 12px;
}

/* ─── Dialogs ─── */
QDialog {
    background-color: #0F172A;
}

/* ─── Permission panel ─── */
#permScroll {
    border: 1px solid #1E293B;
    border-radius: 10px;
    background-color: #020617;
}
#permContainer { background: transparent; }
#permLabel { color: #F8FAFC; font-size: 13px; }
#inheritedLabel { color: #64748B; font-size: 11px; }
#inheritedLabel[has_base="true"]  { color: #10B981; }
#inheritedLabel[has_base="false"] { color: #EF4444; }

/* ─── Toasts ─── */
#toastNotification {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 12px;
}
#toastNotification[type="success"] { border-left: 5px solid #10B981; background-color: rgba(166,227,161,0.08); }
#toastNotification[type="error"]   { border-left: 5px solid #EF4444; background-color: rgba(243,139,168,0.08); }
#toastNotification[type="warning"] { border-left: 5px solid #f9e2af; background-color: rgba(249,226,175,0.08); }
#toastNotification[type="info"]    { border-left: 5px solid #3B82F6; background-color: rgba(137,180,250,0.08); }

#toastMsg {
    color: #F8FAFC;
    font-size: 13px;
    font-weight: 600;
}

/* ─── Detection list ─── */
#detectionsList {
    background-color: #020617;
    border: none;
    border-radius: 8px;
    color: #10B981;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 12px;
}

/* ─── Audit Result Badge ─── */
#auditResultBadge {
    font-size: 13px;
    font-weight: 900;
    color: #64748B;
    background: rgba(49, 50, 68, 0.50);
    border: 1px solid #1E293B;
    border-radius: 6px;
    padding: 2px 8px;
}
#auditResultBadge[result="CONFORME"]      { color: #10B981; background: rgba(166,227,161,0.12); border-color: rgba(166,227,161,0.30); }
#auditResultBadge[result="DISCREPANCIA"] { color: #EF4444; background: rgba(243,139,168,0.12); border-color: rgba(243,139,168,0.30); }

/* ─── Camera URL input ─── */
#camUrlInput {
    background-color: #020617;
    border: 1.5px solid #1E293B;
    border-radius: 8px;
    padding: 6px 14px;
    color: #F8FAFC;
    font-size: 12px;
}
#camUrlInput:focus { border-color: #10B981; }
#camUrlInput::placeholder { color: #334155; }

/* ─── Small player buttons ─── */
#playerBtn_accent {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(139, 92, 246, 0.20), stop:1 rgba(59, 130, 246, 0.15));
    border: 1px solid rgba(139, 92, 246, 0.40);
    border-radius: 8px;
    color: #8B5CF6;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 12px;
}
#playerBtn_accent:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(139, 92, 246, 0.32), stop:1 rgba(59, 130, 246, 0.24));
    border-color: #8B5CF6;
}
#playerBtn_small {
    background-color: rgba(205, 214, 244, 0.07);
    border: 1px solid rgba(69, 71, 90, 0.70);
    border-radius: 8px;
    color: #CBD5E1;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 10px;
}
#playerBtn_small:hover { background-color: rgba(205, 214, 244, 0.13); border-color: rgba(137,180,250,0.35); color: #F8FAFC; }
#playerBtn_small:disabled { color: #334155; border-color: #1E293B; }

/* ─── Camera page selector ─── */
#camSelector {
    min-width: 110px;
}

/* ─── Dahua History Dialog ─── */
#videoPreviewFrame {
    background-color: #020617;
    border: 2px solid #1E293B;
    border-radius: 10px;
    color: #585b70;
    font-size: 14px;
}
#actionsCard {
    background-color: #0B0F19;
    border: 1px solid #1E293B;
    border-radius: 10px;
}

/* ─── GroupBox ─── */
QGroupBox {
    background-color: #0B0F19;
    border: 1px solid #1E293B;
    border-radius: 10px;
    margin-top: 14px;
    padding: 10px;
    color: #3B82F6;
    font-weight: 700;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

/* ─── Calendar ─── */
QCalendarWidget {
    background-color: #020617;
    border: 1px solid #1E293B;
    border-radius: 8px;
}
QCalendarWidget QAbstractItemView:enabled {
    background-color: #020617;
    selection-background-color: #3B82F6;
    selection-color: #020617;
    color: #F8FAFC;
}
QCalendarWidget QWidget#qt_calendar_navigationbar { background-color: #0B0F19; }
QCalendarWidget QToolButton {
    color: #3B82F6;
    font-weight: 700;
    background: transparent;
    border-radius: 4px;
    padding: 4px;
}
QCalendarWidget QToolButton:hover { background: #1E293B; }
QCalendarWidget QSpinBox {
    background: #0B0F19;
    border: 1px solid #1E293B;
    color: #F8FAFC;
}
QCalendarWidget QHeaderView { outline: none; border: none; }

/* ─── Speed label (legacy) ─── */
#speedLabel {
    font-size: 24px;
    font-weight: 900;
    color: #3B82F6;
    background: #0B0F19;
    border-radius: 8px;
    padding: 10px;
    border: 1px solid #1E293B;
}

/* ─── Slider (zona de cámara) ─── */
QSlider::groove:horizontal {
    height: 5px;
    border-radius: 2px;
    background: #1E293B;
}
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3B82F6, stop:1 #8B5CF6);
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
    background: #F8FAFC;
    border: 2px solid #3B82F6;
}
QSlider::handle:horizontal:hover { background: #3B82F6; }

/* ─── Video Slider override (keeps event markers visible) ─── */
#videoSlider::groove:horizontal {
    height: 6px;
    border-radius: 3px;
    background: #1E293B;
}
#videoSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3B82F6, stop:1 #10B981);
    border-radius: 3px;
}
#videoSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
    background: #F8FAFC;
    border: 2px solid #3B82F6;
}

/* ─── Horizontal scrollbar for QListWidget captures ─── */
QListWidget {
    background-color: #020617;
    border: 1px solid #1E293B;
    border-radius: 8px;
    outline: none;
}
QListWidget::item { padding: 4px; border-radius: 4px; }
QListWidget::item:hover { background: rgba(137,180,250,0.10); }
QListWidget::item:selected { background: rgba(137,180,250,0.20); color: #F8FAFC; }

/* ─── Message Boxes ─── */
QMessageBox {
    background-color: #0F172A;
    color: #F8FAFC;
}
QMessageBox QLabel { color: #F8FAFC; font-size: 13px; }
QMessageBox QPushButton {
    background: #1E293B;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 20px;
    font-weight: 700;
    min-width: 80px;
}
QMessageBox QPushButton:hover { background: #334155; border-color: #3B82F6; }
QMessageBox QPushButton:default { background: #3B82F6; color: #020617; border: none; }
QMessageBox QPushButton:default:hover { background: #818CF8; }
