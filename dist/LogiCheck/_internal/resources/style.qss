/* ============================================================
   LogiCheck — Tema Oscuro Premium (Catppuccin Mocha)
   ============================================================ */

/* --- Global --- */
QMainWindow {
    background-color: #1e1e2e;
    font-family: 'Segoe UI', 'Inter', Arial, sans-serif;
    color: #cdd6f4;
    font-size: 13px;
}

/* Force transparency on all child widgets to prevent white boxes */
QWidget {
    background: transparent;
    font-family: 'Segoe UI', 'Inter', Arial, sans-serif;
    color: #cdd6f4;
    font-size: 13px;
}

QLabel {
    background: transparent;
    border: none;
}

QFrame {
    background: transparent;
    border: none;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: #181825;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #45475a;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #585b70;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* --- Sidebar --- */
#sidebar {
    background-color: #11111b;
    border-right: 1px solid #1e1e2e;
}

#brandLabel {
    font-size: 22px;
    font-weight: 900;
    color: #89b4fa;
    letter-spacing: 1px;
}

#versionLabel {
    font-size: 11px;
    color: #6c7086;
    margin-left: 4px;
}

#sectionLabel {
    font-size: 10px;
    font-weight: 700;
    color: #6c7086;
    letter-spacing: 2px;
    margin-left: 4px;
}

#separator {
    background-color: #313244;
}

/* Nav Buttons */
#navButton {
    background: transparent;
    color: #a6adc8;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 500;
}
#navButton:hover {
    background-color: #1e1e2e;
    color: #cdd6f4;
}
#navButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(137, 180, 250, 0.18), stop:1 rgba(137, 180, 250, 0.06));
    color: #89b4fa;
    font-weight: 700;
    border-left: 3px solid #89b4fa;
}

/* Theme toggle label */
#themeLabel {
    font-size: 12px;
    color: #a6adc8;
}

/* User card */
#userCard {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 10px;
}
#userName {
    font-size: 13px;
    font-weight: 700;
    color: #cdd6f4;
}
#userRole {
    font-size: 11px;
    color: #6c7086;
}

/* --- Top Bar --- */
#topBar {
    background-color: #181825;
    border-bottom: 1px solid #1e1e2e;
}
#pageTitle {
    font-size: 18px;
    font-weight: 800;
    color: #cdd6f4;
}
#datetimeLabel {
    font-size: 12px;
    color: #a6adc8;
}

/* --- Content Area --- */
#contentArea {
    background-color: #1e1e2e;
}

/* --- Glow Cards --- */
#glowCard, #statCard {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 12px;
}
#glowCard:hover, #statCard:hover {
    border-color: #45475a;
}

/* Welcome Banner */
#welcomeBanner {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1e1e2e, stop:0.5 #1a1a2e, stop:1 #181825);
    border: 1px solid #313244;
    border-radius: 16px;
}
#welcomeTitle {
    font-size: 24px;
    font-weight: 900;
    color: #cdd6f4;
}
#welcomeSub {
    font-size: 13px;
    color: #a6adc8;
    line-height: 1.5;
}

/* Stat Cards */
#statDesc {
    font-size: 12px;
    color: #6c7086;
}

/* Card titles */
#cardTitle {
    font-size: 15px;
    font-weight: 700;
    color: #cdd6f4;
    padding-bottom: 8px;
}

#subtleText {
    font-size: 12px;
    color: #6c7086;
}

#modelKey {
    font-size: 13px;
    font-weight: 600;
    color: #a6adc8;
    padding: 4px 0;
}
#modelValue {
    font-size: 13px;
    color: #cdd6f4;
    padding: 4px 0;
}

/* --- Buttons --- */
QPushButton#primaryBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #89b4fa, stop:1 #74c7ec);
    color: #11111b;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#primaryBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #b4befe, stop:1 #89dceb);
}
QPushButton#primaryBtn:pressed {
    background: #74c7ec;
}

QPushButton#secondaryBtn {
    background: transparent;
    color: #89b4fa;
    border: 2px solid #89b4fa;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#secondaryBtn:hover {
    background: rgba(137, 180, 250, 0.12);
}

QPushButton#successBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #a6e3a1, stop:1 #94e2d5);
    color: #11111b;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#successBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #b4eeaf, stop:1 #a6f0e0);
}

QPushButton#dangerBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #f38ba8, stop:1 #eba0ac);
    color: #11111b;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#dangerBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #f5a0b8, stop:1 #f0b8c0);
}

/* --- Tables --- */
QTableWidget {
    background-color: #1e1e2e;
    alternate-background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 8px;
    gridline-color: #313244;
    font-size: 12px;
    selection-background-color: rgba(137, 180, 250, 0.2);
    selection-color: #cdd6f4;
}

QHeaderView::section {
    background-color: #11111b;
    color: #a6adc8;
    padding: 8px 10px;
    border: none;
    border-bottom: 2px solid #313244;
    font-weight: 700;
    font-size: 12px;
}

QTableWidget::item {
    padding: 6px 10px;
    border-bottom: 1px solid #1e1e2e;
}

QTableCornerButton::section {
    background-color: #11111b;
    border: none;
}

/* --- Video Frame --- */
#videoFrame {
    background-color: #11111b;
    border: 2px dashed #313244;
    border-radius: 12px;
    font-size: 15px;
    color: #585b70;
}

/* --- Progress Bar --- */
#videoProgress {
    background-color: #313244;
    border: none;
    border-radius: 3px;
}
#videoProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #89b4fa, stop:1 #a6e3a1);
    border-radius: 3px;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #11111b;
    color: #6c7086;
    font-size: 11px;
    border-top: 1px solid #1e1e2e;
    padding: 2px 10px;
}

/* --- Logout Button --- */
#logoutBtn {
    background: transparent;
    color: #f38ba8;
    border: 1px solid rgba(243, 139, 168, 0.35);
    border-radius: 8px;
    text-align: left;
    padding: 0 14px;
    font-size: 12px;
    font-weight: 600;
}
#logoutBtn:hover {
    background: rgba(243, 139, 168, 0.12);
    border-color: #f38ba8;
    color: #f38ba8;
}
#logoutBtn:pressed {
    background: rgba(243, 139, 168, 0.22);
}
